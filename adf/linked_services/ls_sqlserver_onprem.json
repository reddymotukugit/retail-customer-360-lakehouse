{
  "name": "ls_sqlserver_onprem",
  "type": "Microsoft.DataFactory/factories/linkedservices",
  "properties": {
    "description": "On-premises SQL Server 2022 Express via Self-Hosted Integration Runtime",
    "type": "SqlServer",
    "typeProperties": {
      "server": "@{linkedService().sql_server_host}",
      "database": "RetailDB",
      "authenticationType": "SQL",
      "userName": "sa",
      "password": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "referenceName": "ls_keyvault",
          "type": "LinkedServiceReference"
        },
        "secretName": "sql-server-password"
      },
      "encrypt": "false",
      "trustServerCertificate": true
    },
    "connectVia": {
      "referenceName": "shir-onprem-sqlserver",
      "type": "IntegrationRuntimeReference"
    },
    "parameters": {
      "sql_server_host": {
        "type": "string",
        "defaultValue": "20.62.125.63"
      }
    }
  }
}
